#version 460
#extension GL_ARB_shader_draw_parameters : require
#extension GL_EXT_debug_printf : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types : require

#define PAGE_SIZE (1 * 1024 * 1024)

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

#include "mesh_shading/mesh.h"

layout(std430, binding = 1) readonly buffer VisibleClusterCountsBuffer
{
    uint visible_cluster_count;
};

layout(std430, binding = 2) readonly buffer VisibleClustersBuffer
{
    uint visible_clusters[];
};

layout(buffer_reference, std430) buffer _scene_data
{
    uint scene_data[];
};

layout(std430, binding = 3) buffer SceneDataBufferAddressList
{
    _scene_data scene_data_buffer_addresses[];
};

layout(std430, binding = 4) buffer ClusterGroupBuffer {
    ClusterGroup cluster_groups[];
};

layout(buffer_reference, std430) buffer _cluster_data {
    Cluster clusters[];
};

layout(std430, binding = 5) buffer ClusterBufferAddress
{
    _cluster_data cluster_buffer_address;
};

layout(std430, binding = 6) buffer DrawCountsBuffer {
    uint draw_count;
};

layout(std430, binding = 7) buffer CountsBuffer {
    uint total_vertex_count;
    uint total_index_count;
};

layout(std430, binding = 8) buffer IndirectCommandBuffer
{
    IndirectCommand indirect_commands[];
};

layout (buffer_reference, std430) buffer _global_index
{
    uint global_indices[];
};

layout (std430, binding = 9) buffer GlobalIndexBufferAddress
{
    _global_index global_index_buffer_address;
};

layout(push_constant) uniform ClusterConstant {
    uint  total_cluster_count;
} cc;

void main()
{   
    uint visible_cluster_index = gl_GlobalInvocationID.x;

    if (visible_cluster_index >= visible_cluster_count)
        return;

    uint cluster_index = visible_clusters[visible_cluster_index];

    _cluster_data cd = cluster_buffer_address;
    Cluster cluster  = cd.clusters[cluster_index];

    uint instance_index = cluster.instance_index;

    ClusterGroup cluster_group = cluster_groups[cluster.cluster_group_index];

    uint buffer_index = cluster_group.page_index;
    uint page_offset  = cluster_group.page_offset;

    _scene_data sdb = scene_data_buffer_addresses[buffer_index];

    uint triangles_offset = page_offset + cluster_group.triangles_offset;

    uint vertex_count    = sdb.scene_data[page_offset + cluster_group.meshlets_offset + cluster.cluster_index * 4 + 1];
    uint triangle_offset = sdb.scene_data[page_offset + cluster_group.meshlets_offset + cluster.cluster_index * 4 + 2];
    uint triangle_count  = sdb.scene_data[page_offset + cluster_group.meshlets_offset + cluster.cluster_index * 4 + 3];

    uint draw_index    = atomicAdd(draw_count, 1);

    uint index_offset  = atomicAdd(total_index_count, triangle_count * 3);

    uint vertex_offset = atomicAdd(total_vertex_count, vertex_count);

    _global_index gi = global_index_buffer_address;

    for (uint i = 0; i < triangle_count; i++)
    {
        uint packed_triangle = sdb.scene_data[triangles_offset + triangle_offset + i];
        
        uint idx0 = (packed_triangle >> 0) & 0xFFu;
        uint idx1 = (packed_triangle >> 8) & 0xFFu;
        uint idx2 = (packed_triangle >> 16) & 0xFFu;

        gi.global_indices[index_offset + i * 3 + 0] = idx0;
        gi.global_indices[index_offset + i * 3 + 1] = idx1;
        gi.global_indices[index_offset + i * 3 + 2] = idx2;
    }

    IndirectCommand cmd;
    cmd.instance_count = 1;
    cmd.first_instance = draw_index;
    cmd.index_count    = triangle_count * 3;
    cmd.first_index    = index_offset;
    cmd.vertex_offset  = int(vertex_offset);
    cmd.instance_index = instance_index;
    cmd.cluster_index  = cluster_index;

    indirect_commands[draw_index] = cmd;

}